# Copy this file to .env and fill in deployment-specific values.
# Never commit the real .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=inventory_fifo
MYSQL_USER=inventory_app
MYSQL_PASSWORD=replace-with-a-strong-password
# 新增财务结构核验后显式启用，默认保持既有业务路径。
FIFO_FINANCIAL_CONTROLS_ENABLED=0
# Read-only PostgreSQL connection to the OA approval archive. Required for
# automatic "房租+水电+网费" calculation in the store profit-and-loss report.
OA_DB_HOST=oa-postgres.internal
OA_DB_PORT=5432
OA_DB_DATABASE=dingtalk_oa
OA_DB_USER=fifo_oa_report
OA_DB_PASSWORD=replace-with-a-read-only-password
# Compose 必填；使用强随机 JWT 密钥，不采用源码默认值。
JWT_SECRET=replace-with-a-long-random-secret

# 客户端配置前 hybrid 保留本地密码登录。
FIFO_AUTH_MODE=hybrid
# 生产公开来源；本地 HTTP 测试留空或填写独立注册的 loopback 来源。
FIFO_PUBLIC_BASE_URL=https://fifo.yueweiportal.com
# 仅局域网HTTP测试：默认关闭；须将上方公开来源留空，精确列出来源及端口。
# 示例：http://192.168.5.238:8010；多个来源用英文逗号分隔，不支持域名/通配符。
FIFO_LAN_HTTP_TEST_ORIGINS=
EIMS_ISSUER=https://eims.yueweiportal.com
EIMS_CLIENT_ID=
EIMS_CLIENT_SECRET=
# 独立 Fernet 密钥，仅后端保存。
SSO_TOKEN_ENCRYPTION_KEY=
