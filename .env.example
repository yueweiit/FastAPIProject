# Copy this file to .env and fill in deployment-specific values.
# Never commit the real .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=inventory_fifo
MYSQL_USER=inventory_app
MYSQL_PASSWORD=replace-with-a-strong-password
# Optional but recommended in production; set a long random value.
JWT_SECRET=replace-with-a-long-random-secret
